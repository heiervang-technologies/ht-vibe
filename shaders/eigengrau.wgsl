const CX_PI: f32 = 3.141592653589793;
const CX_TAU: f32 = 6.283185307179586;

// ──── Cyclic 4-phase weights (wraps smoothly mod 4: 0->1->2->3->0) ────
fn cx_phase_weights(phase_in: f32) -> vec4f {
    let p = phase_in - 4.0 * floor(phase_in * 0.25);
    let d0 = min(abs(p - 0.0), 4.0 - abs(p - 0.0));
    let d1 = min(abs(p - 1.0), 4.0 - abs(p - 1.0));
    let d2 = min(abs(p - 2.0), 4.0 - abs(p - 2.0));
    let d3 = min(abs(p - 3.0), 4.0 - abs(p - 3.0));

    let w0 = max(0.0, 1.0 - d0 * 0.95);
    let w1 = max(0.0, 1.0 - d1 * 0.95);
    let w2 = max(0.0, 1.0 - d2 * 0.95);
    let w3 = max(0.0, 1.0 - d3 * 0.95);

    let s = vec4f(
        w0 * w0 * (3.0 - 2.0 * w0),
        w1 * w1 * (3.0 - 2.0 * w1),
        w2 * w2 * (3.0 - 2.0 * w2),
        w3 * w3 * (3.0 - 2.0 * w3)
    );
    return s / max(s.x + s.y + s.z + s.w, 1e-4);
}

// ──── Branch-cut-free complex wave dislocation helpers ────
// Couples a carrier phase `theta` with the complex pinwheel unit phasor `z_hat = (cx, sy)`
// by strength `k_disloc` in [0, 1] using single-valued trigonometric addition:
//   (1 - k) * cos(theta) + k * (cos(theta)*cx - sin(theta)*sy)
// This creates genuine topological fork dislocations around pinwheel zeros |Z| = 0
// with C^inf continuity and ZERO branch-cut discontinuities anywhere.
fn cx_disloc_cos(theta: f32, z_hat: vec2f, k_disloc: f32) -> f32 {
    let c = cos(theta);
    let s = sin(theta);
    return mix(c, c * z_hat.x - s * z_hat.y, k_disloc);
}

fn cx_disloc_sin(theta: f32, z_hat: vec2f, k_disloc: f32) -> f32 {
    let c = cos(theta);
    let s = sin(theta);
    return mix(s, s * z_hat.x + c * z_hat.y, k_disloc);
}

// // ──── Hypercolumn Orientation Order Parameter Z(u, v) = X + iY ────
// Synthesizes the complex V1 orientation column map on the cortical cylinder.
// Uses low-order integer azimuthal winding numbers m in Z so topological zeros
// Z(u, v) = 0 form a sparse constellation of distinct, localized pinwheel
// singularities rather than global noise, with zero seam at theta = +/-pi.
// Returns vec4f(X, Y, grad_mag, jacobian).
fn cx_hypercolumn_field(u: f32, v: f32, flow: f32, defect_drive: f32, az_env: f32) -> vec4f {
    let ku = 2.0 + defect_drive * 0.9;
    let drift = flow * (0.16 + defect_drive * 0.10);

    // Four low-order cylindrical modes (integer m = 1, 2, -2, 3) for sparse, clean pinwheels
    let p1 =  ku * 0.92 * u + 1.0 * v - drift * 0.75 + 0.40;
    let p2 = -ku * 0.85 * u + 2.0 * v + drift * 0.60 + 1.95;
    let p3 =  ku * 1.08 * u - 2.0 * v + drift * 0.45 + 3.10;
    let p4 = -ku * 0.76 * u + 3.0 * v - drift * 0.80 + 4.55;

    let higher = (0.30 + 0.70 * defect_drive) * az_env;

    // Complex order parameter Z = X + iY
    let x_raw = cos(p1) * 0.44 + cos(p2) * 0.38 * az_env
              + cos(p3) * 0.32 * higher + cos(p4) * 0.24 * higher;
    let y_raw = sin(p1) * 0.44 + sin(p2) * 0.38 * az_env
              - sin(p3) * 0.32 * higher + sin(p4) * 0.24 * higher;

    // Analytic local cortical gradient for scale-invariant pinwheel core localization
    let dx_du = -ku * (0.92 * sin(p1) * 0.44 - 0.85 * sin(p2) * 0.38 + 1.08 * sin(p3) * 0.32);
    let dy_du =  ku * (0.92 * cos(p1) * 0.44 - 0.85 * cos(p2) * 0.38 - 1.08 * cos(p3) * 0.32);
    let dx_dv = -1.0 * sin(p1) * 0.44 - 2.0 * sin(p2) * 0.38 + 2.0 * sin(p3) * 0.32;
    let dy_dv =  1.0 * cos(p1) * 0.44 + 2.0 * cos(p2) * 0.38 + 2.0 * cos(p3) * 0.32;

    let grad_mag = sqrt(max(dx_du * dx_du + dy_du * dy_du + dx_dv * dx_dv + dy_dv * dy_dv, 0.08));
    // Topological Jacobian J = dX/du * dY/dv - dX/dv * dY/du (signed pinwheel charge density)
    let jacobian = (dx_du * dy_dv - dx_dv * dy_du) / (grad_mag * grad_mag + 0.15);

    return vec4f(x_raw, y_raw, grad_mag, jacobian);
}

// ──── Bressloff-Cowan V1 Planform Evaluator ────
// Evaluates the 4 Kluver form-constant families on cortical coordinates (u, v).
// Dislocations are gated by `local_disloc`, which is non-zero ONLY in the immediate
// neighborhood of topological pinwheel cores |Z| -> 0, so patterns remain razor-crisp
// globally while visibly breaking/rejoining at localized pinwheel defects.
// Returns vec2f(activity_field, filigree_field).
fn cx_eval_planforms(
    u: f32,
    v: f32,
    flow: f32,
    weights: vec4f,
    local_disloc: f32,
    z_hat: vec2f,
    az_env: f32
) -> vec2f {
    // ── Form 0: TUNNEL / FUNNEL (Crisp Rings x Spokes Polar Checkerboard Funnel) ──
    // Concentric depth rings crossed by 16 radial funnel spokes (m = 8 pairs).
    // Saturating the ring and spoke cosines with `inverseSqrt(w^2 + 0.14)` squares off
    // the polar tiles so contours trace crisp concentric tunnel hoops and straight
    // radial spokes rather than rounded ovals, closing into bullseye rings at the fovea.
    let q_tun = 11.0;
    let u_tun = q_tun * u - flow * 2.1;
    let ring_wave  = cx_disloc_cos(u_tun, z_hat, local_disloc);
    let spoke_wave = cos(8.0 * v);
    let rw = ring_wave * inverseSqrt(ring_wave * ring_wave + 0.12);
    let sw = spoke_wave * inverseSqrt(spoke_wave * spoke_wave + 0.12);
    let checker = rw * sw;
    let tunnel_act  = mix(rw * 0.85, 0.72 * checker + 0.30 * rw, az_env) + 0.12;
    let tunnel_lace = clamp(
        max(exp(-abs(ring_wave) * 5.2) * 0.90, exp(-abs(spoke_wave) * 5.5) * 0.85 * az_env),
        0.0,
        1.0
    );

    // ── Form 1: LOGARITHMIC SPIRALS (10 Regular Constant-Pitch Log-Spiral Arms) ──
    // Exact constant-pitch logarithmic spiral w = cos(q_sp * u + 10 * v - flow).
    // Using the phase-locked Chebyshev harmonic (2*w_main^2 - 1) keeps all 10 spiral
    // arms razor-clean through local pinwheel Y-forks with zero detached bubbles.
    let q_sp = 10.5;
    let sp_main  = q_sp * u + 10.0 * v - flow * 2.2;
    let w_main   = cx_disloc_cos(sp_main, z_hat, local_disloc);
    let w_sin    = cx_disloc_sin(sp_main, z_hat, local_disloc);
    let w_harm   = 2.0 * w_main * w_main - 1.0;
    let spiral_act  = (0.88 * w_main + 0.14 * w_harm) * mix(0.68, 1.0, az_env);
    let spiral_lace = clamp(exp(-abs(w_sin) * 5.2) * 0.92, 0.0, 1.0);

    // ── Form 2: HEXAGONAL LATTICE (Conformal D6 Honeycomb Triad k1 + k2 + k3 = 0) ──
    // Hexagonal symmetry requires the phason sum h1 + h2 + h3 = 0 identically.
    // Localized dislocations enter via smooth cortical strain (u_hex, v_hex) so
    // phase closure holds everywhere while rows shift across local pinwheels.
    let q_hex = 11.547005;
    let u_hex = u + 0.14 * (z_hat.x * cos(4.0 * v) + z_hat.y * sin(4.0 * v)) * local_disloc;
    let v_hex = v + 0.10 * (z_hat.y * cos(q_hex * 0.5 * u) - z_hat.x * sin(q_hex * 0.5 * u)) * local_disloc;
    let h1 =  q_hex * u_hex - flow * 1.50;
    let h2 = -0.5 * q_hex * u_hex + 10.0 * v_hex + 0.75 * flow * 1.50;
    let h3 = -0.5 * q_hex * u_hex - 10.0 * v_hex + 0.75 * flow * 1.50;
    let hex_sum = (cos(h1) + (cos(h2) + cos(h3)) * az_env) / (1.0 + 2.0 * az_env);
    let hex_cell = smoothstep(0.08, 0.52, hex_sum);
    let hex_wall = exp(-abs(hex_sum + 0.24) * 9.0) * az_env;
    let lattice_lace = clamp(exp(-abs(hex_sum - 0.22) * 8.0) * 0.90 + hex_wall * 0.85, 0.0, 1.0);
    let lattice_act  = max(hex_cell, hex_wall * 0.88) * 1.48 - 0.52;

    // ── Form 3: COBWEB FILIGREE (Radial Spokes + Scalloped Catenary Spiderweb Lace) ──
    // 12 radial spoke threads + concentric rings that festoon/sag inward between spokes.
    let q_cob = 11.5;
    let spoke_c12 = cos(12.0 * v);
    let spoke_c24 = cos(24.0 * v);
    let u_catenary = q_cob * u + 0.46 * spoke_c12 * az_env - flow * 1.6;
    let ring_cat   = cx_disloc_cos(u_catenary, z_hat, local_disloc);
    let rib_thread  = pow(max(0.0, spoke_c12), 7.0) * az_env;
    let cat_thread  = exp(-abs(ring_cat) * 5.0);
    let diag_arch   = exp(-abs(cos(0.5 * q_cob * u + 6.0 * v - flow * 0.8) * cos(0.5 * q_cob * u - 6.0 * v - flow * 0.8)) * 6.5) * az_env;
    let cobweb_lace = clamp(max(rib_thread * 0.92, cat_thread * 0.88) + diag_arch * 0.38 + pow(max(0.0, spoke_c24), 10.0) * 0.25 * az_env, 0.0, 1.0);
    let cobweb_act  = cobweb_lace * 1.55 - 0.60;

    let psi = weights.x * tunnel_act
            + weights.y * spiral_act
            + weights.z * lattice_act
            + weights.w * cobweb_act;

    let lace = weights.x * tunnel_lace
             + weights.y * spiral_lace
             + weights.z * lattice_lace
             + weights.w * cobweb_lace;

    return vec2f(psi, lace);
}

// ──── Primary Public Entrypoint ────
fn cortex(uv: vec2f, t: f32, org: vec4f) -> vec4f {
    // 1. Unpack conductor organization vector:
    //    org.x = form phase (mod 4: 0 tunnel, 1 spiral, 2 lattice, 3 cobweb)
    //    org.y = cortical wave speed (~0.05 .. 1.5)
    //    org.z = defect density (0 .. 1)
    //    org.w = excitability (0 .. 1)
    let form_phase   = org.x;
    let wave_speed   = clamp(org.y, 0.02, 2.5);
    let defect_drive = clamp(org.z, 0.0, 1.0);
    let excite       = clamp(org.w, 0.0, 1.0);

    // Effective cortical phase clock driven by wave_speed
    let flow = t * (0.36 + wave_speed * 0.80);

    // 2. Gentle cortical precession so the field rotates organically
    let precess = t * 0.030 + 0.10 * sin(t * 0.08);
    let cp = cos(precess);
    let sp = sin(precess);
    let p = vec2f(cp * uv.x - sp * uv.y, sp * uv.x + cp * uv.y);

    // 3. Inverse Retinocortical Log-Polar Map: p -> (r, theta) -> cortical (u, v)
    let r2 = dot(p, p);
    let r  = sqrt(r2);
    let v  = atan2(p.y, p.x);

    // Regularized foveal radius r0 prevents log(0) singularity at fixation center
    let r0 = 0.038;
    let u_base = log(sqrt(r2 + r0 * r0) / r0);

    // Smooth foveal envelope for m != 0 azimuthal modes so r -> 0 is C^inf pinch-free
    let az_env = r2 / (r2 + r0 * r0 * 1.8);

    // 4. V1 Orientation Hypercolumn Complex Field Z(u, v) = X + iY & Pinwheel Singularities
    let hc = cx_hypercolumn_field(u_base, v, flow, defect_drive, az_env);
    let z_xy   = hc.xy;
    let z_mag2 = dot(z_xy, z_xy);
    let z_grad = hc.z;
    let z_jac  = hc.w;

    // Smooth normalized complex phasor z_hat = (X, Y) / sqrt(|Z|^2 + eps^2)
    // Vanishes smoothly right at pinwheel singularity cores |Z| = 0, unit length elsewhere.
    let z_hat = z_xy * inverseSqrt(z_mag2 + 0.008);

    // Orientation preference angle in [0, pi) radians (unoriented axis).
    // Doubling orientation in perception.wgsl (2.0 * orientation = atan2(Y, X) + PI)
    // is 2*pi-periodic and has ZERO color seam across the +/-pi branch cut!
    let z_arg = atan2(z_xy.y, z_xy.x);
    let orientation = z_arg * 0.5 + CX_PI * 0.5;

    // Strictly Localized Pinwheel Defect Cores & Dislocation Envelope:
    // `norm_mag2` is normalized so it is < 1 ONLY within the tight core radius of a
    // true topological zero Z(u, v) = 0, and >> 5 everywhere else. This guarantees
    // pinwheels act as sparse, localized dislocation events rather than global wobble.
    let norm_mag2 = z_mag2 / (z_grad * z_grad * 0.009 + 0.003);
    let pinwheel_core = exp(-norm_mag2 * 2.2);
    let pinwheel_halo = exp(-norm_mag2 * 0.75) * clamp(abs(z_jac) * 1.4, 0.25, 1.0);
    let defect = clamp((pinwheel_core * 0.85 + pinwheel_halo * 0.35) * smoothstep(0.02, 0.90, defect_drive), 0.0, 1.0);

    // Local dislocation coupling: strictly zero over >90% of the field, rising to ~0.95
    // only around pinwheel singularity cores so wavefronts visibly fork and rejoin locally.
    let local_disloc = exp(-norm_mag2 * 0.65) * (0.20 + 0.80 * defect_drive) * az_env;

    // 5. Evaluate Bressloff-Cowan Planforms
    let weights = cx_phase_weights(form_phase);

    // Cut intracortical hypercolumn turbulence by ~75% for tunnel & spiral so their
    // rings and constant-pitch arms stay razor-crisp; keep organic warp for lattice/lace.
    let warp_scale = 0.22 * (weights.x + weights.y) + 0.95 * (weights.z + weights.w);
    let u = u_base + (0.015 + 0.020 * defect_drive) * warp_scale * z_xy.x * az_env;

    let plan_c = cx_eval_planforms(u, v, flow, weights, local_disloc, z_hat, az_env);
    let psi    = plan_c.x;

    // 6. Scale-Invariant Cortical Filigree / Nodal Contour Ridge (`edge`)
    // Evaluated analytically in a single pass so 3x/pixel afterimage calls stay ultra-fast.
    let dist_nodal = abs(psi - 0.12);
    let ridge_grad = exp(-dist_nodal * dist_nodal * 28.0);
    let edge = clamp(max(plan_c.y * 0.88, ridge_grad * 0.78) + pinwheel_core * 0.30, 0.0, 1.0);

    // 7. V1 Firing Activity (`activity` in [0, 1])
    let hyper_ripple = 0.032 * warp_scale * (z_hat.x * cos(14.0 * u) - z_hat.y * sin(14.0 * u)) * az_env;
    let gain = 2.1 + 0.75 * excite;
    let raw_drive = (psi + hyper_ripple - 0.10) * gain;
    let firing = 1.0 / (1.0 + exp(-raw_drive));

    // Gentle foveal calm + peripheral readiness
    let foveal_env = 0.84 + 0.16 * smoothstep(0.0, 0.05, r);
    let activity = clamp(firing * foveal_env, 0.0, 1.0);

    return vec4f(activity, orientation, defect, edge);
}

// EIGENGRAU — P2: perception, color and analytic persistence.
// Contract: uv half-height 1; cortex = activity, orientation radians, defect, edge.
// org = form phase, wave speed, defect density, excitability; bands in 0..1.
// Three cortex calls. Echoes re-evaluate the past with CURRENT organization:
// these are stylized persistence, not framebuffer history or past audio.
// Returns tone-mapped LINEAR RGB in 0..1. The renderer handles display encoding.
// Physiology is artistic inspiration, not a model of an observer's vision.

fn pc_hash(p: vec2f) -> f32 {
    var q = fract(vec3f(p.x, p.y, p.x) * 0.1031);
    q += dot(q, q.yzx + vec3f(33.33));
    return fract((q.x + q.y) * q.z);
}

fn pc_noise(p: vec2f) -> f32 {
    let cell = floor(p);
    let f = fract(p);
    let u = f * f * (vec2f(3.0) - 2.0 * f);
    return mix(mix(pc_hash(cell), pc_hash(cell + vec2f(1.0, 0.0)), u.x),
               mix(pc_hash(cell + vec2f(0.0, 1.0)),
                   pc_hash(cell + vec2f(1.0, 1.0)), u.x), u.y);
}

// Each form has a recognizable phosphor color: violet tunnel, jade spiral,
// amber cells, rose lace. Smooth cyclic interpolation includes lace -> tunnel.
// Orientation is only a small chromatic accent, periodic across the PI seam.
fn pc_emission(orientation: f32, uv: vec2f, t: f32, form: f32) -> vec3f {
    let colors = array<vec3f, 4>(vec3f(0.34, 0.018, 1.0),
                                vec3f(0.015, 1.0, 0.55),
                                vec3f(1.0, 0.38, 0.025),
                                vec3f(1.0, 0.028, 0.30));
    let phase = form - 4.0 * floor(form * 0.25);
    let index = u32(floor(phase));
    let blend = smoothstep(0.0, 1.0, fract(phase));
    let base = mix(colors[index], colors[(index + 1u) % 4u], blend);
    let axis = 2.0 * orientation;
    let drift = 0.20 * sin(t * 0.047) + 0.22 * sin(uv.x * 1.1 + uv.y * 0.7);
    let accent = vec3f(0.93) + 0.07 * sin(vec3f(axis + drift) + vec3f(0.0, 2.1, 4.2));
    return base * accent;
}

// Screen-space contours turn the smooth activity into fine phosphor filaments.
// Core edge strength gates them; broad activity contributes only a faint cubic
// glow. This stays sparse even when the core's edge channel saturates over lobes.
fn pc_ink(field: vec4f) -> f32 {
    let activity = clamp(field.x, 0.0, 1.0);
    let width = max(fwidth(activity), 0.0005);
    let distance = abs(activity - 0.55) / width;
    let edge = clamp(field.w, 0.0, 1.0);
    let filament = exp(-distance * distance * 3.20) * (0.30 + 0.70 * edge);
    // Exponential wings spread softly beyond the Gaussian line, while edge
    // strength localizes the glow to the same cortical structures.
    let halo = exp(-distance * 0.28) * 0.006 * (0.40 + 0.60 * edge);
    let body = activity * activity * activity * 0.001;
    return filament + halo + body;
}

// Sparse, broad phosphenes with smooth temporal envelopes. Nine neighbor cells
// avoid hard cell boundaries. Their density is fixed: no frame-random flicker.
fn pc_phosphenes(uv: vec2f, t: f32) -> f32 {
    let p = uv * 9.0;
    let cell = floor(p);
    let local = fract(p);
    var glow = 0.0;
    for (var y = -1; y <= 1; y += 1) {
        for (var x = -1; x <= 1; x += 1) {
            let offset = vec2f(f32(x), f32(y));
            let id = cell + offset;
            let seed = pc_hash(id + vec2f(71.3, 19.7));
            let center = vec2f(pc_hash(id + vec2f(3.1)), pc_hash(id + vec2f(47.2)));
            let d = local - offset - (0.15 + 0.70 * center);
            let envelope = pow(0.5 + 0.5 * sin(t * (0.21 + seed * 0.17)
                                              + seed * 31.0), 8.0);
            let sparse = smoothstep(0.78, 0.95, seed);
            glow += exp(-dot(d, d) * 40.0) * envelope * sparse;
        }
    }
    return glow;
}

// An almost imperceptible curved branching shadow off the fovea; neither a
// literal vessel diagram nor a visible foreground object. Never exceeds 2%.
fn pc_vascular_shadow(uv: vec2f, t: f32) -> f32 {
    let p = uv - vec2f(0.68, -0.17);
    var shadow = 0.0;
    for (var i = 0; i < 3; i += 1) {
        let fi = f32(i);
        let angle = -1.8 + fi * 1.65;
        let q = vec2f(cos(angle) * p.x - sin(angle) * p.y,
                       sin(angle) * p.x + cos(angle) * p.y);
        let curve = 0.16 * sin(q.x * 3.2 + fi) * q.x;
        let thickness = 0.008 + fwidth(q.y - curve);
        let trunk = exp(-pow((q.y - curve) / thickness, 2.0));
        let branch = exp(-pow((q.y - curve - 0.32 * (q.x - 0.25))
                              / (thickness * 0.72), 2.0));
        let along = smoothstep(0.0, 0.18, q.x) * (1.0 - smoothstep(0.65, 1.25, q.x));
        shadow = max(shadow, (trunk + branch * smoothstep(0.25, 0.45, q.x)) * along);
    }
    return min(shadow, 1.0) * (0.011 + 0.009 * sin(t * 0.11) * sin(t * 0.11));
}

fn perceive(uv: vec2f, t: f32, org: vec4f, bands: vec3f) -> vec3f {
    let excitation = clamp(org.w, 0.0, 1.0);
    let audio = clamp(bands, vec3f(0.0), vec3f(1.0));
    let field = cortex(uv, t, org);
    // Temporal persistence only: spatial rescaling reads as defocus.
    let echo_a = cortex(uv, t - 0.65, org);
    let echo_b = cortex(uv, t - 1.70, org);
    let ink = pc_ink(field);
    let ink_a = pc_ink(echo_a);
    let ink_b = pc_ink(echo_b);
    let pigment = pc_emission(field.y, uv, t, org.x);
    let pigment_a = pc_emission(echo_a.y, uv, t - 0.65, org.x);
    let pigment_b = pc_emission(echo_b.y, uv, t - 1.70, org.x);

    let r2 = dot(uv, uv);
    let fovea = 0.82 + 0.18 * smoothstep(0.0, 0.075, r2);
    let surround = 0.30 + 0.70 * exp(-0.32 * r2);
    let breath = 0.85 + 0.15 * sin(t * 0.19 + 0.4 * sin(t * 0.071));
    let cloud = pc_noise(uv * 2.2 + vec2f(t * 0.012, -t * 0.009));
    let rod = pc_noise(uv * 145.0 + vec2f(t * 0.15, t * 0.11)) - 0.5;
    let quiet = 1.0 - smoothstep(0.10, 0.65, excitation);
    var color = vec3f(0.0030, 0.0027, 0.0045) * breath * (0.78 + 0.44 * cloud);
    color += vec3f(0.0006, 0.0006, 0.0009) * rod * quiet;
    color += vec3f(0.026, 0.033, 0.049) * pc_phosphenes(uv, t) * (0.25 + 0.75 * quiet);

    let presence = excitation * (0.75 + 0.25 * excitation);
    let foreground = pigment * ink * (2.30 + 0.22 * audio.y) * (1.0 + 0.04 * audio.x);
    let phase = org.x - 4.0 * floor(org.x * 0.25);
    let lattice = 1.0 - smoothstep(0.0, 1.0, abs(phase - 2.0));
    let activity = clamp(field.x, 0.0, 1.0);
    let cells = pigment * (0.006 * lattice * activity * activity * activity);
    // Complementary residuals are strongest where the current field has faded.
    // Gentle opponent-channel attenuation gives a bleaching impression without
    // subtracting the background or generating negative RGB values.
    let exposed = 1.0 - 0.80 * min(ink, 1.0);
    let complement_a = pow(vec3f(1.0) - pigment_a * 0.95, vec3f(3.0));
    let complement_b = pow(vec3f(1.0) - pigment_b * 0.95, vec3f(3.0));
    let residual = (complement_a * ink_a * 0.040 + complement_b * ink_b * 0.012) * exposed;
    let bleach = vec3f(1.0) - 0.10 * pigment_a * ink_a;
    let pearl = vec3f(0.80, 0.87, 0.95) * pow(min(ink, 1.0), 5.0)
                * (0.025 + 0.08 * clamp(field.z, 0.0, 1.0));
    color += (foreground * bleach + residual + pearl + cells) * presence * fovea;
    color *= surround * (1.0 - pc_vascular_shadow(uv, t));

    // Soft exponential shoulder preserves chromatic highlights, finite at rest.
    return clamp(vec3f(1.0) - exp(-max(color, vec3f(0.0)) * 1.35), vec3f(0.0), vec3f(1.0));
}

// ---------------------------------------------------------------------------
// CONDUCTOR — turns music into cortical organization.
//
// Owns every read of freqs / iTime / iBPM / iMouse*. Parts downstream receive
// everything through arguments, so this file is the single source of musical
// truth.
//
//   org.x  form phase, wraps mod 4: 0 tunnel, 1 spiral, 2 lattice, 3 cobweb lace
//   org.y  cortical wave speed (~0.05 .. 1.5)
//   org.z  defect density 0..1
//   org.w  excitability 0..1 (0 = Eigengrau rest, 1 = full form)
//
// The form sequence advances on phrase boundaries (16 beats) and morphs during
// the last bar of each phrase, so changes land where a listener expects them.
// The spectrum's brightness bends the morph locally: bright music leans toward
// the lattice/lace side of the cycle, dark music toward tunnel/spiral.
// Clicking the screen is pressing on the eyelid: a pressure phosphene that
// floods the field with defects and slowly fades.
// ---------------------------------------------------------------------------

const CD_BEATS_PER_PHRASE: f32 = 16.0;
const CD_FALLBACK_BPM: f32 = 96.0;

fn cd_band(lo: f32, hi: f32) -> f32 {
    let n = arrayLength(&freqs);
    if (n == 0u) {
        return 0.0;
    }
    let nf = f32(n);
    let a = u32(clamp(lo * nf, 0.0, nf - 1.0));
    let b = max(u32(clamp(hi * nf, 0.0, nf)), a + 1u);
    var s = 0.0;
    for (var i = a; i < b; i = i + 1u) {
        s = s + freqs[i];
    }
    return s / f32(b - a);
}

// Smoothed-looking bands in 0..1. Vibe already eases freqs between frames;
// the soft knee keeps loud masters from pinning everything at 1.
fn cd_bands() -> vec3f {
    let raw = vec3f(cd_band(0.0, 0.08), cd_band(0.08, 0.45), cd_band(0.45, 1.0));
    return clamp(raw / (raw + vec3f(0.35)) * 1.35, vec3f(0.0), vec3f(1.0));
}

fn cd_bpm() -> f32 {
    return select(CD_FALLBACK_BPM, clamp(iBPM, 50.0, 200.0), iBPM > 1.0);
}

// Beats elapsed since start (continuous).
fn cd_beats() -> f32 {
    return iTime * cd_bpm() / 60.0;
}

// Sharp-attack, slow-release pulse on every beat, 0..1.
fn cd_beat_pulse() -> f32 {
    let f = fract(cd_beats());
    return exp(-f * 6.0);
}

// Seconds since the last click, or a large number if there is none.
fn cd_since_click() -> f32 {
    if (iMouseClick.x < 0.0) {
        return 1e4;
    }
    return max(iTime - iMouseClick.z, 0.0);
}

// Pressure phosphene envelope: blooms over ~0.4 s, fades over ~6 s.
fn cd_pressure() -> f32 {
    let s = cd_since_click();
    return smoothstep(0.0, 0.4, s) * exp(-s / 2.5);
}

// Gaze offset in contract uv units: the field drifts a little toward the
// pointer, as if the eye were following it.
fn cd_gaze() -> vec2f {
    let m = clamp(iMouse, vec2f(0.0), vec2f(1.0)) - vec2f(0.5);
    let aspect = iResolution.x / max(iResolution.y, 1.0);
    return vec2f(m.x * aspect, -m.y) * 0.18;
}

fn cd_org(bands: vec3f) -> vec4f {
    let bass = bands.x;
    let mid = bands.y;
    let treble = bands.z;
    let level = dot(bands, vec3f(0.5, 0.3, 0.2));
    let press = cd_pressure();

    // Form phase: one form per phrase, morphing through the final bar.
    let phrase = cd_beats() / CD_BEATS_PER_PHRASE;
    let morph = smoothstep(0.75, 1.0, fract(phrase));
    var phase = floor(phrase) + morph;
    // Spectral brightness leans the cycle; the lean is bounded so the
    // phrase structure always wins.
    let centroid = (mid * 0.5 + treble) / max(bass + mid + treble, 1e-3);
    phase = phase + 0.32 * (centroid - 0.45) * smoothstep(0.03, 0.2, level);

    // Wave speed: mids drive lateral travel, each beat gives a small shove.
    let speed = 0.06 + 1.15 * pow(mid, 1.2) + 0.25 * bass * cd_beat_pulse();

    // Defects: treble births pinwheels; pressure floods the field with them.
    let defects = clamp(pow(treble, 0.8) * 0.85 + press * 0.9, 0.0, 1.0);

    // Excitability: silence relaxes into Eigengrau; a slow breath (~11 s)
    // keeps even steady music from becoming wall-to-wall pattern.
    let breath = 0.5 + 0.5 * sin(iTime * 0.57);
    let drive = smoothstep(0.02, 0.4, level) * mix(0.72, 1.0, breath);
    let excite = clamp(max(drive + 0.18 * bass * cd_beat_pulse(), press), 0.0, 1.0);

    return vec4f(phase - 4.0 * floor(phase / 4.0), speed, defects, excite);
}

@fragment
fn main(@builtin(position) pos: vec4<f32>) -> @location(0) vec4<f32> {
    // Contract uv: centered, aspect-correct, half-height = 1, +y up.
    let half_h = max(iResolution.y, 1.0) * 0.5;
    var uv = (pos.xy - iResolution.xy * 0.5) / half_h;
    uv.y = -uv.y;
    uv = uv - cd_gaze();

    let bands = cd_bands();
    let org = cd_org(bands);
    // perceive() returns linear light; vibe presents to a UNORM surface
    // (Bgra8Unorm/Rgba8Unorm), so the sRGB encode happens here, once.
    let lin = clamp(perceive(uv, iTime, org, bands), vec3f(0.0), vec3f(1.0));
    var col = select(1.055 * pow(lin, vec3f(1.0 / 2.4)) - 0.055, lin * 12.92, lin <= vec3f(0.0031308));

    // Triangular dither: the dark end of this piece lives in the bottom few
    // code values, where 8-bit banding would otherwise show.
    let h = fract(sin(dot(pos.xy, vec2f(12.9898, 78.233))) * 43758.5453);
    let h2 = fract(sin(dot(pos.xy, vec2f(39.3468, 11.135))) * 24634.6345);
    col = col + (h + h2 - 1.0) / 255.0;

    return vec4f(max(col, vec3f(0.0)), 1.0);
}

